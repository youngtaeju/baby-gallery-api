{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/app/baby-gallery.db"
  },
  "Jwt": {
    "Issuer": "baby-gallery-api",
    "Audience": "baby-gallery-app",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 60
  },
  "Gallery": {
    "RootPath": "/data/gallery"
  },
  "Indexing": {
    "IntervalMinutes": 10,
    "TimeZone": "Asia/Seoul"
  },
  "Upload": {
    "StagingDirectoryName": ".uploads",
    "TrashDirectoryName": ".trash",
    "TrashRetentionDays": 30,
    "MaxUploadSizeBytes": 2147483648,
    "SessionExpirationHours": 24
  },
  "Thumbnail": {
    "CachePath": "/data/app/thumbnails",
    "FfmpegPath": "ffmpeg",
    "MaxConcurrency": 2,
    "TimeoutSeconds": 30
  }
}
